{
  "name": "copado-hx",
  "version": "1.0.0",
  "description": "Headless CLI for Copado DevOps",
  "main": "dist/index.js",
  "bin": {
    "copado-hx": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
